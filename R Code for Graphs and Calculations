> 
> # IMAGEJ DATA
> 
> soy_red <- c(137.123, 141.660, 172.591)
> 
> almond_red <- c(190.984, 166.126, 155.335)
> 
> 
> # ==========================================
> # CALIBRATION EQUATION
> # ==========================================
> 
> # C = slope * pixel intensity + intercept
> 
> slope <- -0.074685
> intercept <- 13.70344
> 
> # Dilution factor
> DF <- 10
> 
> 
> # ==========================================
> # CALCULATE PROTEIN CONCENTRATIONS
> # ==========================================
> 
> # Diluted protein concentrations (mg/mL)
> 
> soy_conc <- slope * soy_red + intercept
> 
> almond_conc <- slope * almond_red + intercept
> 
> 
> # Original undiluted concentrations (mg/mL)
> 
> soy_original <- soy_conc * DF
> 
> almond_original <- almond_conc * DF
> 
> 
> # ==========================================
> # CALCULATE STATISTICS
> # ==========================================
> 
> soy_mean <- mean(soy_original)
> soy_sd <- sd(soy_original)
> 
> almond_mean <- mean(almond_original)
> almond_sd <- sd(almond_original)
> 
> 
> # ==========================================
> # FUNCTION TO CREATE GRAPHS
> # ==========================================
> 
> make_graph <- function(data, title) {
+     
+     mean_value <- mean(data)
+     sd_value <- sd(data)
+     
+     par(mar = c(5, 5, 4, 2) + 0.1)
+     
+     plot(
+         1, mean_value,
+         type = "n",
+         xlim = c(0.5, 1.5),
+         ylim = range(c(data, mean_value - sd_value,
+                        mean_value + sd_value)) + c(-10, 10),
+         xaxt = "n",
+         xlab = "Color Channel",
+         ylab = "Measured Area",
+         main = title,
+         cex.main = 1.1,
+         cex.lab = 1.2,
+         las = 1,
+         bty = "l"
+     )
+     
+     # Standard deviation error bars
+     arrows(
+         x0 = 1,
+         y0 = mean_value - sd_value,
+         x1 = 1,
+         y1 = mean_value + sd_value,
+         angle = 90,
+         code = 3,
+         length = 0.08,
+         col = "firebrick",
+         lwd = 2
+     )
+     
+     # Individual measurements
+     points(
+         x = c(0.96, 1, 1.04),
+         y = data,
+         pch = 16,
+         col = "firebrick",
+         cex = 1.4
+     )
+     
+     # Mean diamond
+     points(
+         1, mean_value,
+         pch = 18,
+         col = "firebrick",
+         cex = 1.8
+     )
+     
+     # X-axis
+     axis(
+         1,
+         at = 1,
+         labels = "Red",
+         cex.axis = 1.2
+     )
+     
+     # Legend
+     legend(
+         "topleft",
+         legend = c(
+             "Individual Measurements",
+             "Mean",
+             "Mean +/- SD"
+         ),
+         pch = c(16, 18, NA),
+         lty = c(NA, NA, 1),
+         col = "firebrick",
+         bty = "n",
+         cex = 0.9
+     )
+ }
> 
