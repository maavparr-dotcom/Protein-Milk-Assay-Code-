> draw_regression <- function(slope, intercept, color,
+                             x_max, y_max) {
+     
+     # Generate X values
+     x <- seq(0, x_max, length.out = 1000)
+     
+     # Calculate predicted Y values
+     y <- intercept + slope * x
+     
+     # Keep only values inside graph boundaries
+     valid <- (
+         x >= 0 &
+             x <= x_max &
+             y >= 0 &
+             y <= y_max
+     )
+     
+     # Draw only valid portion
+     lines(
+         x[valid],
+         y[valid],
+         col = color,
+         lwd = 2.5
+     )
+ }
